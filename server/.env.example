# SePay QR + webhook
SEPAY_BANK_ACCOUNT=YOUR_BANK_ACCOUNT_NUMBER
SEPAY_BANK_CODE=VCB
SEPAY_API_KEY=YOUR_SEPAY_WEBHOOK_API_KEY

# Cloudinary server-side values are kept here for future server uploads.
CLOUDINARY_CLOUD_NAME=YOUR_CLOUD_NAME
CLOUDINARY_API_KEY=YOUR_CLOUDINARY_API_KEY
CLOUDINARY_API_SECRET=YOUR_CLOUDINARY_API_SECRET

# Gmail SMTP for forgot password emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=dungdinh542004@gmail.com
SMTP_PASS=YOUR_GMAIL_APP_PASSWORD
